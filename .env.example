# URL of the BraiderShield site (product link)
NEXT_PUBLIC_SHIELD_URL=http://localhost:3001
# Optional: contact-form submissions are POSTed here as JSON (e.g. an n8n webhook)
LEAD_WEBHOOK_URL=
# Optional: sent as the x-webhook-secret header so n8n can reject requests that aren't from this site
LEAD_WEBHOOK_SECRET=
